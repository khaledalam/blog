---
import { COUNTER_URL } from '../config';
interface Props { slug: string; seed?: number; }
const { slug, seed = 0 } = Astro.props;
// With no live counter and no seeded count there is nothing truthful to show,
// so render nothing rather than a misleading "0 views" / "— views".
const show = COUNTER_URL || seed > 0;
---
{show && (
  <span class="views" data-slug={slug} data-seed={seed}>
    {seed ? seed.toLocaleString() : '—'} views
  </span>
)}

{COUNTER_URL && (
  <script is:inline define:vars={{ COUNTER_URL, slug, seed }}>
    (async () => {
      const el = document.currentScript.previousElementSibling;
      // A visit counts once per post per 10 minutes, per browser. Reloading
      // inside the window re-reads the count without incrementing; coming back
      // after it counts as a fresh visit.
      const key = `viewed:${slug}`;
      const WINDOW = 10 * 60 * 1000;
      let counted = false;
      try {
        counted = Date.now() - Number(localStorage.getItem(key) || 0) < WINDOW;
      } catch (_) { /* private mode: fall through and just count it */ }

      const path = counted
        ? `/get/${encodeURIComponent(slug)}`
        : `/hit/${encodeURIComponent(slug)}`;
      try {
        const r = await fetch(`${COUNTER_URL}${path}`, { method: counted ? 'GET' : 'POST' });
        if (r.ok) {
          const { views } = await r.json();
          if (typeof views === 'number') el.textContent = `${views.toLocaleString()} views`;
          if (!counted) {
            try { localStorage.setItem(key, String(Date.now())); } catch (_) {}
          }
        }
      } catch (_) { /* keep the static seed value on failure */ }
    })();
  </script>
)}
