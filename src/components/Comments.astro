---
import { GISCUS } from '../config';

interface Props { title: string; slug: string; }
const { title, slug } = Astro.props;

// giscus needs its GitHub App installed on the repo. If it is ever removed,
// giscus renders "giscus is not installed on this repository" to every reader —
// set GISCUS.enabled to false and this falls back to plain GitHub Discussions
// links, which need no app.
const giscusOn = GISCUS.enabled && GISCUS.repoId && GISCUS.categoryId;

// "General" rather than the giscus category: Announcements is maintainer-only,
// so readers could not open a thread there.
const newThread =
  `https://github.com/${GISCUS.repo}/discussions/new` +
  `?category=general&title=${encodeURIComponent(title)}` +
  `&body=${encodeURIComponent(`Re: https://blog.khaledalam.net/${slug}/\n\n`)}`;
const allThreads = `https://github.com/${GISCUS.repo}/discussions`;
---
<section class="comments">
  <h2>Comments</h2>
  {giscusOn ? (
    <script
      src="https://giscus.app/client.js"
      data-repo={GISCUS.repo}
      data-repo-id={GISCUS.repoId}
      data-category={GISCUS.category}
      data-category-id={GISCUS.categoryId}
      data-mapping={GISCUS.mapping}
      data-strict="1"
      data-reactions-enabled={GISCUS.reactionsEnabled}
      data-emit-metadata="0"
      data-input-position="top"
      data-theme={GISCUS.theme}
      data-lang="en"
      crossorigin="anonymous"
      async
    ></script>
  ) : (
    <p class="comments-fallback">
      <a href={newThread} target="_blank" rel="noopener">Discuss this post on GitHub</a>
      <span> · </span>
      <a href={allThreads} target="_blank" rel="noopener">browse all discussions</a>
    </p>
  )}
</section>
