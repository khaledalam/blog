---
import Base from '../layouts/Base.astro';
import Views from '../components/Views.astro';
import Comments from '../components/Comments.astro';
import { SITE, PERSON, COUNTER_URL } from '../config';
import posts from '../data/posts.json';
import { rewriteBody, size, webp } from '../lib/images';

export function getStaticPaths() {
  return posts.map(p => ({
    // Decode %-encoded (Arabic) slugs so the emitted directory is UTF-8;
    // requests to the original encoded WordPress URL decode to the same path.
    params: { slug: decodeURIComponent(p.slug) },
    props: { post: p },
  }));
}

const { post } = Astro.props;
const fmt = (d: string) =>
  new Date(d).toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' });
// Upper-case %XX so canonical, og:url and JSON-LD match the sitemap byte for byte (Arabic slugs).
const canonical = new URL(`/${post.slug}/`, SITE.url).href.replace(/%[0-9a-f]{2}/g, s => s.toUpperCase());

// Body: real image sizes, lazy loading, WebP, no repeat of the hero; then heading anchors for the TOC.
const toc: { id: string; text: string }[] = [];
const used = new Set<string>();
const body = (await rewriteBody(post.html, post.hero)).replace(
  /<h([23])(\s[^>]*)?>([\s\S]*?)<\/h\1>/g,
  (m, level, attrs = '', inner) => {
    if (/\sid=/.test(attrs)) return m;
    const text = inner.replace(/<[^>]+>/g, '').replace(/&amp;/g, '&').replace(/&#?\w+;/g, '').trim();
    let id = text.toLowerCase().replace(/[^\p{L}\p{N}]+/gu, '-').replace(/^-|-$/g, '').slice(0, 60) || 'section';
    for (let n = 2; used.has(id); n++) id = `${id.replace(/-\d+$/, '')}-${n}`;
    used.add(id);
    if (level === '2') toc.push({ id, text });
    return `<h${level}${attrs} id="${id}">${inner}<a class="anchor" href="#${id}" aria-label="Link to this section">#</a></h${level}>`;
  },
);
const heroSize = post.hero ? (post.heroW && post.heroH ? { w: post.heroW, h: post.heroH } : await size(post.hero)) : null;
const heroWebp = post.hero ? webp(post.hero) : null;
const label = post.categories.find((c: string) => !['software', 'Uncategorized'].includes(c)) ?? 'Software';
const showViews = Boolean(COUNTER_URL) || post.views > 0;

const wordCount = post.html.replace(/<[^>]*>/g, ' ').split(/\s+/).filter(Boolean).length;

// Related posts: most category overlap first, then most recent. Gives every post
// inbound internal links instead of leaving older posts reachable only from the
// index, which is the single biggest crawl-depth problem on a flat blog.
const related = posts
  .filter(p => p.slug !== post.slug && p.lang === post.lang)
  .map(p => ({ p, shared: p.categories.filter(c => post.categories.includes(c)).length }))
  .filter(r => r.shared > 0)
  .sort((a, b) => b.shared - a.shared || Date.parse(b.p.date) - Date.parse(a.p.date))
  .slice(0, 3)
  .map(r => r.p);
const jsonLd = [
  {
    '@type': 'BlogPosting',
    '@id': `${canonical}#article`,
    isPartOf: { '@id': `${SITE.url}/#website` },
    mainEntityOfPage: { '@type': 'WebPage', '@id': canonical },
    url: canonical,
    headline: post.title,
    description: post.description,
    ...(post.hero
      ? {
          image: {
            '@type': 'ImageObject',
            url: new URL(post.hero, SITE.url).href,
            ...(heroSize ? { width: heroSize.w, height: heroSize.h } : {}),
          },
          thumbnailUrl: new URL(post.hero, SITE.url).href,
        }
      : {}),
    datePublished: post.date,
    dateModified: post.modified || post.date,
    author: { '@id': PERSON['@id'] },
    publisher: { '@id': PERSON['@id'] },
    inLanguage: post.lang,
    wordCount,
    ...(post.categories.length ? { articleSection: post.categories } : {}),
    ...(post.categories.length || post.tags.length
      ? { keywords: [...post.categories, ...post.tags] }
      : {}),
  },
  {
    '@type': 'BreadcrumbList',
    '@id': `${canonical}#breadcrumb`,
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Blog', item: `${SITE.url}/` },
      { '@type': 'ListItem', position: 2, name: post.title, item: canonical },
    ],
  },
];
---
<Base
  title={post.seoTitle}
  description={post.description}
  canonical={canonical}
  ogImage={post.hero}
  lang={post.lang}
  dir={post.dir}
  type="article"
  jsonLd={jsonLd}
  imageAlt={post.heroAlt}
  imageW={post.heroW}
  imageH={post.heroH}
  articleMeta={{
    published: post.date,
    modified: post.modified || post.date,
    section: post.categories,
    tags: post.tags,
  }}
>
  <article lang={post.lang} dir={post.dir}>
    <nav class="crumbs" aria-label="Breadcrumb" dir="ltr">
      <a href="/">Blog</a><span aria-hidden="true">/</span><span class="label">{label}</span>
    </nav>
    <h1>{post.title}</h1>
    <div class="byline" dir="ltr">
      <img src="/avatar.webp" alt="" width="38" height="38" />
      <div>
        <div class="who"><a href="https://khaledalam.net" rel="author">Khaled Alam</a></div>
        <div class="meta">
          <time datetime={post.date}>{fmt(post.date)}</time>
          {post.modified && post.modified.slice(0, 10) !== post.date.slice(0, 10) && (
            <span class="dot">Updated <time datetime={post.modified}>{fmt(post.modified)}</time></span>
          )}
          <span class="dot">{post.readingMinutes} min read</span>
          {showViews && <span class="dot"><Views slug={post.slug} seed={post.views} /></span>}
        </div>
      </div>
    </div>
    {post.hero && (
      <picture>
        {heroWebp && <source srcset={heroWebp} type="image/webp" />}
        <img
          class="article-hero"
          src={post.hero}
          alt={post.heroAlt}
          width={heroSize?.w}
          height={heroSize?.h}
          loading="eager"
          fetchpriority="high"
          decoding="async"
        />
      </picture>
    )}
    {toc.length >= 3 && (
      <details class="toc" open>
        <summary>{post.lang === 'ar' ? 'المحتويات' : 'On this page'}</summary>
        <ol>{toc.map(h => <li><a href={`#${h.id}`}>{h.text}</a></li>)}</ol>
      </details>
    )}
    <div class="post-body" set:html={body} />
    {post.tags.length > 0 && (
      <div class="tags" dir="ltr">
        {post.tags.map((t: string) => <span>{t}</span>)}
      </div>
    )}
    <aside class="author-box" dir="ltr" lang="en">
      <img src="/avatar.webp" alt="Khaled Alam" width="56" height="56" loading="lazy" />
      <div>
        <p class="name">Khaled Alam</p>
        <p>Software Specialist in Dubai with 10+ years building production SaaS, PropTech, FinTech and e-commerce products. Author of a PHP RFC merged into PHP 8.6.</p>
        <div class="links">
          <a href="https://khaledalam.net" rel="author">About me</a>
          <a href="https://github.com/khaledalam" rel="me noopener" target="_blank">GitHub</a>
          <a href="https://linkedin.com/in/khaledalam" rel="me noopener" target="_blank">LinkedIn</a>
        </div>
      </div>
    </aside>
  </article>
  {related.length > 0 && (
    <nav class="related" aria-label="Related posts" lang={post.lang} dir={post.dir}>
      <h2>{post.lang === 'ar' ? 'مقالات ذات صلة' : 'Related posts'}</h2>
      <ul>
        {related.map(r => (
          <li>
            <a class={r.hero ? 'card' : 'card no-thumb'} href={`/${r.slug}/`}>
              <div>
                <h3>{r.title}</h3>
                <span class="meta">{fmt(r.date)} · {r.readingMinutes} min read</span>
              </div>
              {r.hero
                ? <img class="thumb" src={webp(r.hero, true) ?? r.hero} alt="" width="96" height="64" loading="lazy" decoding="async" />
                : null}
            </a>
          </li>
        ))}
      </ul>
    </nav>
  )}
  <Comments title={post.title} slug={post.slug} />
</Base>
