---
import Base from '../layouts/Base.astro';
import { SITE, PERSON } from '../config';
import posts from '../data/posts.json';

const items = posts.map(p => ({
  slug: p.slug,
  title: p.title,
  description: p.description,
  date: p.date,
  views: p.views,
  readingMinutes: p.readingMinutes,
  dir: p.dir,
  lang: p.lang,
}));
const fmt = (d: string) =>
  new Date(d).toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' });

const jsonLd = [
  {
    '@type': 'Blog',
    '@id': `${SITE.url}/#blog`,
    url: `${SITE.url}/`,
    name: SITE.title,
    description: SITE.description,
    isPartOf: { '@id': `${SITE.url}/#website` },
    author: { '@id': PERSON['@id'] },
    publisher: { '@id': PERSON['@id'] },
    inLanguage: [...new Set(posts.map(p => p.lang))],
  },
  {
    '@type': 'ItemList',
    '@id': `${SITE.url}/#posts`,
    numberOfItems: items.length,
    itemListElement: items.map((p, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      url: new URL(`/${p.slug}/`, SITE.url).href,
      name: p.title,
    })),
  },
];
---
<Base title={SITE.title} description={SITE.description} jsonLd={jsonLd}>
  <h1 style="margin-top:2rem;">Blog</h1>
  <p style="color:var(--muted);">
    Software engineering, PHP internals, AI, and side projects. {items.length} posts.
  </p>
  <ul class="post-list">
    {items.map(p => (
      <li>
        <h2><a href={`/${p.slug}/`} lang={p.lang} dir={p.dir}>{p.title}</a></h2>
        <div class="meta">
          <span>{fmt(p.date)}</span>
          <span>· {p.readingMinutes} min read</span>
          {p.views > 0 && <span>· {p.views.toLocaleString()} views</span>}
        </div>
        <p class="excerpt" lang={p.lang} dir={p.dir}>{p.description}</p>
      </li>
    ))}
  </ul>
</Base>
