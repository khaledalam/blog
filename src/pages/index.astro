---
import Base from '../layouts/Base.astro';
import { SITE, PERSON, COUNTER_URL } from '../config';
import posts from '../data/posts.json';

import { webp } from '../lib/images';

// Topic chips filter the list in place. Each groups a few WordPress categories.
const TOPICS: Record<string, string[]> = {
  PHP: ['php', 'open source'],
  'AI': ['ai'],
  Projects: ['projects', 'saas'],
  'How-to': ['howto', 'api', 'javascript', 'algorithm'],
  Leadership: ['cto', 'management', 'dubai'],
};
const topicsOf = (cats: string[]) =>
  Object.entries(TOPICS).filter(([, c]) => cats.some(x => c.includes(x))).map(([t]) => t);
const labelOf = (cats: string[]) =>
  topicsOf(cats)[0] ?? cats.find(c => !['software', 'Uncategorized'].includes(c)) ?? 'Software';

const items = posts.map(p => ({
  slug: p.slug,
  title: p.title,
  description: p.description,
  date: p.date,
  views: p.views,
  readingMinutes: p.readingMinutes,
  dir: p.dir,
  lang: p.lang,
  thumb: p.hero ? webp(p.hero, true) ?? p.hero : null,
  large: p.hero ? webp(p.hero) ?? p.hero : null,
  heroAlt: p.heroAlt ?? '',
  topics: topicsOf(p.categories),
  label: labelOf(p.categories),
}));
const fmt = (d: string) =>
  new Date(d).toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' });

const jsonLd = [
  {
    '@type': 'Blog',
    '@id': `${SITE.url}/#blog`,
    url: `${SITE.url}/`,
    name: SITE.title,
    description: SITE.description,
    isPartOf: { '@id': `${SITE.url}/#website` },
    author: { '@id': PERSON['@id'] },
    publisher: { '@id': PERSON['@id'] },
    inLanguage: [...new Set(posts.map(p => p.lang))],
  },
  {
    '@type': 'ItemList',
    '@id': `${SITE.url}/#posts`,
    numberOfItems: items.length,
    itemListElement: items.map((p, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      url: new URL(`/${p.slug}/`, SITE.url).href,
      name: p.title,
    })),
  },
];
---
<Base title={SITE.homeTitle} description={SITE.description} jsonLd={jsonLd}>
  <section class="intro">
    <img src="/avatar.webp" alt="Khaled Alam" width="64" height="64" />
    <div>
      <h1>Khaled Alam's blog</h1>
      <p>PHP internals and RFCs, AI and LLM tools, and the things I build. {items.length} posts.</p>
    </div>
  </section>
  <ul class="topics" aria-label="Filter by topic">
    <li><button type="button" data-topic="" aria-pressed="true">All</button></li>
    {Object.keys(TOPICS).map(t => <li><button type="button" data-topic={t} aria-pressed="false">{t}</button></li>)}
  </ul>
  <ul class="post-list">
    {items.map((p, i) => (
      <li class={i === 0 ? 'featured' : undefined} data-topics={p.topics.join('|')}>
        <a class={p.thumb ? 'card' : 'card no-thumb'} href={`/${p.slug}/`}>
          <div>
            <span class="label">{p.label}</span>
            <h2 lang={p.lang} dir={p.dir}>{p.title}</h2>
            <p class="excerpt" lang={p.lang} dir={p.dir}>{p.description}</p>
            <div class="meta">
              <time datetime={p.date}>{fmt(p.date)}</time>
              <span class="dot">{p.readingMinutes} min read</span>
              {(COUNTER_URL || p.views > 0) && (
                <span class="dot views" data-slug={p.slug}>{p.views > 0 ? `${p.views.toLocaleString()} views` : '— views'}</span>
              )}
            </div>
          </div>
          {p.thumb
            ? <img class="thumb" src={i === 0 ? p.large : p.thumb} alt={p.heroAlt} width={i === 0 ? 1200 : 132} height={i === 0 ? 630 : 88}
                loading={i < 3 ? 'eager' : 'lazy'} fetchpriority={i === 0 ? 'high' : undefined} decoding="async" />
                : null}
        </a>
      </li>
    ))}
  </ul>
  <script is:inline>
    // Topic filter: purely client-side; every post stays in the HTML for crawlers.
    document.querySelector('.topics').addEventListener('click', e => {
      const b = e.target.closest('button');
      if (!b) return;
      for (const x of document.querySelectorAll('.topics button')) x.setAttribute('aria-pressed', String(x === b));
      for (const li of document.querySelectorAll('.post-list > li')) {
        li.hidden = !!b.dataset.topic && !li.dataset.topics.split('|').includes(b.dataset.topic);
      }
    });
  </script>
  {COUNTER_URL && (
    <script is:inline define:vars={{ COUNTER_URL }}>
      // One batch read fills every card. Read-only: the index never increments,
      // only the post page does.
      (async () => {
        const els = [...document.querySelectorAll('.post-list .views[data-slug]')];
        if (!els.length) return;
        const slugs = els.map(e => encodeURIComponent(e.dataset.slug)).join(',');
        try {
          const r = await fetch(`${COUNTER_URL}/get?slugs=${slugs}`);
          if (!r.ok) return;
          const { views } = await r.json();
          for (const el of els) {
            const n = views?.[el.dataset.slug];
            if (typeof n === 'number') el.textContent = `${n.toLocaleString()} views`;
          }
        } catch (_) { /* leave the static seed values in place */ }
      })();
    </script>
  )}
</Base>
