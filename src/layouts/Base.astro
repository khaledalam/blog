---
import '../styles/global.css';
import { SITE, PERSON, GA_ID, TAWK_PROPERTY, TAWK_WIDGET } from '../config';
import Sidebar from '../components/Sidebar.astro';

interface Props {
  title: string;
  description?: string;
  canonical?: string;
  ogImage?: string | null;
  lang?: string;
  dir?: string;
  type?: 'website' | 'article';
  jsonLd?: Record<string, unknown>[];
  imageAlt?: string | null;
  imageW?: number | null;
  imageH?: number | null;
  noindex?: boolean;
  home?: boolean;
  articleMeta?: {
    published?: string;
    modified?: string;
    section?: string[];
    tags?: string[];
  } | null;
}
const {
  title,
  description = SITE.description,
  canonical = new URL(Astro.url.pathname, SITE.url).href,
  ogImage = null,
  lang = 'en',
  dir = 'ltr',
  type = 'website',
  jsonLd = [],
  imageAlt = null,
  imageW = null,
  imageH = null,
  noindex = false,
  home = false,
  articleMeta = null,
} = Astro.props;
const img = ogImage ? new URL(ogImage, SITE.url).href : `${SITE.url}/og-default.png`;
// og-default.png is 1200x630; only override when the page supplied its own hero.
const [ogW, ogH] = ogImage && imageW && imageH ? [imageW, imageH] : [1200, 630];
// og-default.png is the blog's title card; describe it when a page has no hero of its own.
const ogAlt = imageAlt || (ogImage ? null : `${SITE.title}: ${SITE.description}`);
const ogLocale = lang === 'ar' ? 'ar_AR' : 'en_US';

// One @graph per page: the site, the person behind it, then whatever the page
// itself is. Nodes cross-reference by @id so Google resolves a single entity.
const graph = [
  {
    '@type': 'WebSite',
    '@id': `${SITE.url}/#website`,
    url: `${SITE.url}/`,
    name: SITE.title,
    description: SITE.description,
    inLanguage: 'en',
    author: { '@id': PERSON['@id'] },
    publisher: { '@id': PERSON['@id'] },
  },
  PERSON,
  ...jsonLd,
];
// Escape `<` so a description containing markup can never break out of the tag.
const jsonLdText = JSON.stringify({ '@context': 'https://schema.org', '@graph': graph }).replace(
  /</g,
  '\\u003c',
);
---
<!doctype html>
<html lang={lang} dir={dir}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content={SITE.author} />
    <meta
      name="robots"
      content={noindex
        ? 'noindex, follow'
        : 'index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1'}
    />
    <meta name="theme-color" content="#fafafa" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0f1115" media="(prefers-color-scheme: dark)" />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" type="application/rss+xml" title={SITE.title} href={`${SITE.url}/feed.xml`} />
    <meta property="og:type" content={type} />
    <meta property="og:site_name" content={SITE.title} />
    <meta property="og:locale" content={ogLocale} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={img} />
    <meta property="og:image:width" content={String(ogW)} />
    <meta property="og:image:height" content={String(ogH)} />
    {ogAlt && <meta property="og:image:alt" content={ogAlt} />}
    {articleMeta?.published && (
      <meta property="article:published_time" content={articleMeta.published} />
    )}
    {articleMeta?.modified && (
      <meta property="article:modified_time" content={articleMeta.modified} />
    )}
    {articleMeta && <meta property="article:author" content={SITE.authorUrl} />}
    {articleMeta?.section?.map(s => <meta property="article:section" content={s} />)}
    {articleMeta?.tags?.map(t => <meta property="article:tag" content={t} />)}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@KhaledAlamXYZ" />
    <meta name="twitter:creator" content="@KhaledAlamXYZ" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={img} />
    {ogAlt && <meta name="twitter:image:alt" content={ogAlt} />}
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <!-- Non-blocking: text renders at once in the metric-matched fallback, then swaps to Montserrat without shifting. -->
    <link rel="preload" as="style" href="https://fonts.googleapis.com/css2?family=Montserrat:wght@300;400;500;600;700&display=swap" onload="this.onload=null;this.rel='stylesheet'" />
    <noscript><link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Montserrat:wght@300;400;500;600;700&display=swap" /></noscript>
    <script is:inline>
      // Apply the saved theme before first paint (no flash); otherwise follow the system.
      try { const t = localStorage.getItem('theme'); if (t === 'dark' || t === 'light') document.documentElement.dataset.theme = t; } catch (_) {}
    </script>
    <link rel="icon" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/favicon.png" />
    <script type="application/ld+json" set:html={jsonLdText} is:inline />
    {GA_ID && <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${GA_ID}`}></script>}
    {GA_ID && (
      <script is:inline define:vars={{ GA_ID }}>
        // Google Analytics (async, never blocks rendering). No page views are sent
        // for visitors who send Do Not Track or Global Privacy Control.
        window.dataLayer = window.dataLayer || [];
        window.gtag = function () { dataLayer.push(arguments); };
        if (navigator.doNotTrack !== '1' && !navigator.globalPrivacyControl) {
          gtag('js', new Date());
          gtag('config', GA_ID);
        }
      </script>
    )}
  </head>
  <body class:list={{ home }}>
    <button class="theme-toggle" type="button" aria-label="Toggle dark mode" onclick="toggleTheme()">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z" /></svg>
    </button>
    <!-- Compact bar for phones on post pages; the sidebar takes over on wider screens. -->
    <header class="site-header">
      <a class="brand" href="/">
        <img src="/avatar.webp" alt="" width="30" height="30" />
        <span>Khaled Alam</span>
      </a>
      <nav aria-label="Site">
        <a href="https://khaledalam.net" rel="author">About</a>
        <a href="/" aria-current={Astro.url.pathname === '/' ? 'page' : undefined}>Blog</a>
      </nav>
    </header>
    <div class="page">
      <Sidebar home={home} />
      <main>
        <slot />
        <footer class="site-footer">
          <span>© {new Date().getFullYear()} {SITE.author}</span>
          <nav aria-label="Elsewhere">
            <a href="https://khaledalam.net" rel="author">About</a>
            <a href="https://github.com/khaledalam" rel="me noopener" target="_blank">GitHub</a>
            <a href="https://linkedin.com/in/khaledalam" rel="me noopener" target="_blank">LinkedIn</a>
            <a href="/feed.xml">RSS</a>
          </nav>
        </footer>
      </main>
    </div>
    <script is:inline>
      function toggleTheme() {
        const root = document.documentElement;
        const dark = root.dataset.theme ? root.dataset.theme === 'dark' : matchMedia('(prefers-color-scheme: dark)').matches;
        root.dataset.theme = dark ? 'light' : 'dark';
        try { localStorage.setItem('theme', root.dataset.theme); } catch (_) {}
      }
    </script>
    {TAWK_PROPERTY && (
      <script is:inline define:vars={{ src: `https://embed.tawk.to/${TAWK_PROPERTY}/${TAWK_WIDGET}` }}>
        // tawk.to live chat: visitor and chat alerts go to the tawk.to mobile app.
        window.Tawk_API = window.Tawk_API || {};
        window.Tawk_LoadStart = new Date();
        var s = document.createElement('script');
        s.async = true;
        s.src = src;
        s.charset = 'UTF-8';
        s.setAttribute('crossorigin', '*');
        document.body.appendChild(s);
      </script>
    )}
  </body>
</html>
